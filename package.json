{
  "name": "cadence-player-enhanced",
  "version": "2.0.0",
  "description": "An enhanced Electron music player with a custom visualizer and modern UI/UX.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "dist": "electron-builder",
    "test": "vitest run",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier -w .",
    "ci": "npm run lint && npm test"
  },
  "keywords": [
    "electron",
    "music",
    "player",
    "audio",
    "visualizer"
  ],
  "author": "Code Maniac",
  "license": "MIT",
  "dependencies": {
    "music-metadata": "^10.9.1",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "electron": "^39.2.2",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^1.14.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.codemaniac.cadence",
    "productName": "Cadence Player",
    "icon": "assets/icon.png",
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "icon": "assets/icon.png"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "assets/**/*"
    ]
  }
}
