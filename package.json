{
  "name": "cadence-player-enhanced",
  "version": "2.0.0",
  "description": "An enhanced Electron music player with a custom visualizer and modern UI/UX.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "NODE_ENV=development electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:chords": "vitest run test/chord-detector-fixtures.test.js test/chord-detector.test.js",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier -w .",
    "benchmark:chords": "node --experimental-default-type=module scripts/benchmark-chords.mjs",
    "ci": "npm run lint && npm test"
  },
  "keywords": [
    "electron",
    "music",
    "player",
    "audio",
    "visualizer"
  ],
  "author": "Code Maniac",
  "license": "MIT",
  "dependencies": {
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "concurrently": "^9.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  },
  "build": {
    "appId": "com.codemaniac.cadence",
    "productName": "Cadence Player",
    "icon": "assets/icon.png",
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "icon": "assets/icon.png"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "assets/**/*"
    ]
  }
}
